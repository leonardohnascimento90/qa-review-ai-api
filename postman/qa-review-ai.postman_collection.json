{
  "info": {
    "name": "QA Review AI API",
    "description": "Coleção para validação manual dos principais endpoints da QA Review AI API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "bugReviewId",
      "value": ""
    },
    {
      "key": "severityId",
      "value": ""
    },
    {
      "key": "loginEmail",
      "value": "<email-local>"
    },
    {
      "key": "loginPassword",
      "value": "<senha-local>"
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('token', body.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Health e documentação",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Swagger",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/docs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "docs"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Usuários",
      "item": [
        {
          "name": "Listar usuários",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Cadastrar usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuário Postman\",\n  \"email\": \"usuario.postman@example.com\",\n  \"password\": \"senha-local\",\n  \"role\": \"analyst\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Análises de bugs",
      "item": [
        {
          "name": "Listar análises",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bug-reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bug-reviews"
              ]
            }
          }
        },
        {
          "name": "Criar análise",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"O checkout não permite finalizar a compra.\",\n  \"affectedSystem\": \"Checkout\",\n  \"scope\": \"some_users\",\n  \"blocksEssentialFunction\": true,\n  \"hasAlternativeFlow\": false,\n  \"hasDataLoss\": false,\n  \"hasFinancialRisk\": false,\n  \"hasSecurityRisk\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/bug-reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bug-reviews"
              ]
            }
          }
        },
        {
          "name": "Consultar análise por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bug-reviews/{{bugReviewId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bug-reviews",
                "{{bugReviewId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Severidades",
      "item": [
        {
          "name": "Listar severidades",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/severities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "severities"
              ]
            }
          }
        },
        {
          "name": "Cadastrar severidade",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"severity\": \"S4\",\n  \"description\": \"Impacto visual ou cosmético\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/severities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "severities"
              ]
            }
          }
        },
        {
          "name": "Editar severidade",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Critério atualizado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/severities/{{severityId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "severities",
                "{{severityId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}
